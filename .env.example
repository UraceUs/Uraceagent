# Copie para .env e preencha. O .env está no .gitignore.

# Supabase — Connect > Direct connection, porta 5432
DATABASE_URL=postgresql://postgres:SENHA@db.<ref>.supabase.co:5432/postgres

# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=

# Embeddings. Use fake para rodar sem chave e sem custo.
EMBEDDING_PROVIDER=fake
VOYAGE_API_KEY=

# Catálogo (Google Sheets). Opcional: o fixture dispensa ambos.
CATALOG_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Protege a API quando exposta ao n8n
AGENT_API_KEY=

# Kommo — agent/kommo_client.py. Alternativa ao KOMMO_TOKEN: salvar o token
# em ~/.urace/kommo_token.txt (chmod 600), sem passar por variável de ambiente.
# Gerar em: Kommo → Configurações → Integrações → Create integration →
# "Keys and scopes" → "Generate long-lived token". Ver CLAUDE.md.
KOMMO_BASE_URL=https://urace.kommo.com/api/v4
KOMMO_TOKEN=
