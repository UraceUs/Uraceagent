# =============================================================================
# URACE Agente de Vendas — inventário de configuração (SEM valores reais)
# =============================================================================
# A configuração real NÃO usa um .env na raiz: vive em ~/.urace/ no servidor
# (fora do repositório, chmod 600). Este arquivo documenta cada variável.
# NUNCA commite chaves, tokens ou senhas — o .gitignore bloqueia *.env, e a
# revisão de commit confere o diff antes de qualquer push.

# --- ~/.urace/kommo.env ------------------------------------------------------
# Token de longa duração da integração privada do Kommo (API v4)
KOMMO_TOKEN=
# Domínio da conta
KOMMO_DOMAIN=urace.kommo.com
# Client secret da integração (aba "Keys and scopes") — valida a assinatura
# HS512 do token que o Salesbot envia no webhook. Opcional (defesa extra).
KOMMO_BOT_SECRET=

# --- ~/.urace/bridge.env -----------------------------------------------------
# Chave que autentica o Salesbot na ponte (?key= na URL do widget).
# O instalador gera uma automaticamente se não existir.
AGENT_API_KEY=
# WhatsApp interno que recebe escalações (formato +1XXXXXXXXXX)
HUMAN_WHATSAPP=
# Re-alerta de escalação sem ação humana, em minutos (faixa 10–30)
ESCALATION_REALERT_MIN=15
# Id do Salesbot (na URL do editor do bot) — permite follow-up direto no chat
FOLLOWUP_BOT_ID=
# Formato de entrega da resposta: json_reply (mensagem única, widget v2)
# ou balloons (fallback, blocos de <=80 chars)
SALESBOT_DISPLAY=json_reply
# Sales Brain: on = injeta conhecimento relevante por turno + diretiva [[kb]]
BRAIN_RETRIEVAL=off
# Quantos documentos por busca do Brain
BRAIN_TOP_DOCS=3

# --- Outros arquivos em ~/.urace/ -------------------------------------------
# anthropic.key      — chave da API Anthropic (consumida por fix_key.py p/ OpenClaw)
# salesbridge.db     — estado + auditoria da ponte (SQLite, criado sozinho)
# brain-index.db     — índice de busca do Sales Brain (criado pelo indexer)

# --- Variáveis de ambiente opcionais ----------------------------------------
# URACE_DIR          — muda a pasta de segredos/estado (default: ~/.urace)
# BRAIN_INDEX_PATH   — muda o caminho do índice do Brain
