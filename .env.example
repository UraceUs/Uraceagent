# Copie para .env e preencha. O .env está no .gitignore.

# Firestore — projeto Firebase: ia-sales-agent-urace
# Service account: Console Firebase > Configurações > Contas de serviço >
# Gerar nova chave privada. Salve o JSON FORA do repositório.
FIREBASE_SERVICE_ACCOUNT_JSON=/caminho/para/ia-sales-agent-urace-firebase-adminsdk.json
FIRESTORE_PROJECT_ID=ia-sales-agent-urace

# Testes locais: com o emulador rodando, nenhuma credencial é necessária.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8089

# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=

# Embeddings. Use fake para rodar sem chave e sem custo.
EMBEDDING_PROVIDER=fake
VOYAGE_API_KEY=

# Catálogo (Google Sheets). Opcional: o fixture dispensa ambos.
CATALOG_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Protege a API quando exposta ao n8n
AGENT_API_KEY=
