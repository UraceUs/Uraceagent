# ==========================================================================
# URACE Administrative AI — variáveis de ambiente do VPS
# ==========================================================================
#
# COPIE este arquivo para  ~/.urace/adminai.env  e preencha.
# NUNCA comite o arquivo preenchido. O .gitignore já bloqueia *.env, e o
# instalador põe permissão 600 (só o dono lê).
#
#   cp adminai/deploy/adminai.env.example ~/.urace/adminai.env
#   chmod 600 ~/.urace/adminai.env
#   nano ~/.urace/adminai.env
#
# Deixe vazia a variável de um sistema que ainda não vai entrar — o
# instalador avisa o que falta e não instala o timer correspondente.
# --------------------------------------------------------------------------


# --- ASANA -----------------------------------------------------------------
# Personal Access Token. Onde tirar:
#   Asana → foto do perfil → Settings → Apps → Manage Developer Apps
#   → Personal access tokens → Create new token
# Precisa de acesso aos 4 projetos (U-RACE, SUITS, Shipping Orders, ADM URACE).
# É este token que também destrava ANEXAR arquivo na tarefa (POST /attachments),
# que o conector do Claude não faz — ver P-09 no cérebro.
ASANA_TOKEN=

# --- ANTHROPIC -------------------------------------------------------------
# Chave da API que move o agente. Console → https://console.anthropic.com/
# (se o OpenClaw já estiver autenticado por assinatura, pode ficar vazia)
ANTHROPIC_API_KEY=

# --- GOOGLE (Gmail, Calendar, Drive) ---------------------------------------
# As DUAS caixas: urace@ e support@.
# Caminho recomendado (mais simples): acesso delegado da support@ para a
#   urace@ no Google Workspace → Configurações → Contas → Conceder acesso.
#   Assim UMA credencial lê as duas.
# O arquivo de credencial fica FORA do repo, em ~/.urace/.
GOOGLE_CREDENTIALS_JSON=/home/ubuntu/.urace/google-credentials.json
GOOGLE_TOKEN_JSON=/home/ubuntu/.urace/google-token.json

# --- QUICKBOOKS ------------------------------------------------------------
# App em https://developer.intuit.com → Dashboard → seu app → Keys.
# O realm já é conhecido e está no cérebro (PARAMETROS).
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=9341453113046421

# --- DOCUSIGN --------------------------------------------------------------
# App em https://apps.docusign.com/admin/apps-and-keys (conta support@urace.us).
# Autenticação JWT: Integration Key + User ID + a chave privada RSA.
# A chave privada é ARQUIVO, não texto colado aqui.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=b3ef4ae4-917e-4394-96b4-e1e5498cc75b
DOCUSIGN_ACCOUNT_ID=4261a166-3a91-4fb7-97c5-30257d657c52
DOCUSIGN_BASE_URI=https://na4.docusign.net
DOCUSIGN_PRIVATE_KEY_PATH=/home/ubuntu/.urace/docusign-private.key

# --- COMPORTAMENTO ---------------------------------------------------------
# Caminho do repositório no VPS
URACE_REPO=/home/ubuntu/Uraceagent

# APLICAR=0 → tudo roda em simulação (nada é escrito nos sistemas).
# Deixe 0 no primeiro dia. Vire para 1 só depois de ler os relatórios.
APLICAR=0

# Nome do agente no OpenClaw que executa as rotinas diárias
OPENCLAW_AGENT=urace-admin
