[Unit]
Description=URACE — triagem diaria da caixa de e-mail
Documentation=file:///home/ubuntu/Uraceagent/brain/10_PROCESSOS/Triagem%20de%20e-mail.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/Uraceagent
EnvironmentFile=/home/ubuntu/.urace/adminai.env
ExecStartPre=/bin/bash -lc 'mkdir -p "$HOME/.openclaw/workspace/$OPENCLAW_AGENT/brain" && rsync -a --delete brain/ "$HOME/.openclaw/workspace/$OPENCLAW_AGENT/brain/"'
ExecStart=/bin/bash -lc 'openclaw agent --agent "$OPENCLAW_AGENT" --session-key "agent:$OPENCLAW_AGENT:triagem-$(date +%%F)" --thinking medium --timeout 900 -m "Rode a triagem diaria do Gmail conforme brain/10_PROCESSOS/Triagem de e-mail.md. Lembre: a IA NAO envia e-mail, so rascunho, com as excecoes de PARAMETROS. Registre o que fez no diario do cerebro."'
StandardOutput=append:/home/ubuntu/.urace/logs/triagem-email.log
StandardError=append:/home/ubuntu/.urace/logs/triagem-email.log
