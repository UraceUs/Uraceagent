[Unit]
Description=URACE — sincronia status x quadro no Shipping Orders (Asana)
Documentation=file:///home/ubuntu/Uraceagent/brain/10_PROCESSOS/Compra%20e%20envio.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/Uraceagent
EnvironmentFile=/home/ubuntu/.urace/adminai.env
# APLICAR=1 no env troca a simulação por escrita real (ver install_adminai.sh)
ExecStart=/bin/bash -lc 'python3 adminai/asana_status_sync.py $ARGS_SYNC'
StandardOutput=append:/home/ubuntu/.urace/logs/asana-sync.log
StandardError=append:/home/ubuntu/.urace/logs/asana-sync.log
